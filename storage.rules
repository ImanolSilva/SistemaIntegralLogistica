rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.email in ['fernandosilva130501@gmail.com', 'imailin14022002@gmail.com', 'mireyesb@liverpool.com.mx', 'agavila@liverpool.com.mx']
      );
    }

    match /Dashboard/{fileName} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /uploads/evidencias/{fileName} {
      allow read: if signedIn();
      allow write, delete: if isAdmin();
    }
    match /uploads/{fileName} {
      allow read: if signedIn();
      allow write, delete: if isAdmin();
    }
    match /BodegasRelacion/{fileName} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /ExcelManifiestos/{fileName} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /Manifiestos/{store}/{fileName} {
      allow read: if signedIn();
      allow write, delete: if isAdmin();
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
